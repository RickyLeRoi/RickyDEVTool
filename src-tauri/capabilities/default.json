{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:1420"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
